# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# .env is gitignored — never commit real keys.

# ---- Fireworks AI ----
# Get a key at https://fireworks.ai/ (Account -> API Keys)
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI-compatible base URL for the Fireworks inference API
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ---- Models (Fireworks serverless) ----
# Agent / tool-calling LLM
FIREWORKS_LLM_MODEL=accounts/fireworks/models/deepseek-v4-flash
# Embedding model for the PDF index (write + read must match)
FIREWORKS_EMBEDDING_MODEL=accounts/fireworks/models/qwen3-embedding-8b
# Optional cross-encoder rerankerg
FIREWORKS_RERANK_MODEL=accounts/fireworks/models/qwen3-reranker-8b

# ---- Local paths ----
DATABASE_PATH=data/financials.db
PDF_DIR=data/pdfs
VECTOR_STORE_DIR=storage

# ---- App ----
API_HOST=0.0.0.0
API_PORT=8000
